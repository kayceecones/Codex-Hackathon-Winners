PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Set this to actually dispatch approved plans to the Coding + Review service.
# Unset, the Master records the invoke_coding action but never calls anything,
# so execution only advances via a hand-written coding.completed event.
CODING_REVIEW_URL=http://127.0.0.1:4005

# Optional future integration endpoints for teammate services.
# PLANNING_AGENT_WEBHOOK_URL=
# REVIEW_AGENT_WEBHOOK_URL=

# Person 2: DbStore persistence + Notion sync
DATABASE_URL="file:./dev.db"

# Leave these blank to run with Notion sync disabled (no-op, logs a warning).
NOTION_TOKEN=
NOTION_TIMELINE_DB_ID=
NOTION_PLANS_DB_ID=
NOTION_REVIEWS_DB_ID=
