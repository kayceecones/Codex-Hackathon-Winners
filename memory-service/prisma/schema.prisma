generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
}

model Proposal {
  id          String   @id @default(cuid())
  projectId   String
  memberName  String
  title       String
  description String
  status      String   @default("pending") // pending | confirmed | rejected
  createdAt   DateTime @default(now())
}

model PlanVersion {
  id          String   @id @default(cuid())
  projectId   String
  proposalId  String?
  version     Int
  content     String
  diffSummary String?
  status      String   @default("awaiting_decision") // awaiting_decision | needs_revision | approved | superseded | held | rejected
  createdAt   DateTime @default(now())
}

model Approval {
  id            String   @id @default(cuid())
  planVersionId String
  decision      String // approve | request_update | hold | exit
  feedback      String?
  decidedBy     String
  decidedAt     DateTime @default(now())
}

model ExecutionContract {
  id                 String   @id @default(cuid())
  projectId          String
  planVersionId      String
  scope              String
  acceptanceCriteria String
  createdAt          DateTime @default(now())
}

model Implementation {
  id                  String    @id @default(cuid())
  projectId           String
  executionContractId String
  runloopSessionId    String?
  filesChanged        String?
  testResults         String?
  status              String    @default("running") // running | complete | failed
  createdAt           DateTime  @default(now())
  finishedAt          DateTime?
}

model Review {
  id               String   @id @default(cuid())
  projectId        String
  implementationId String
  verdict          String // pass | coding_issue | plan_issue
  notes            String?
  createdAt        DateTime @default(now())
}

model AgentRun {
  id         String    @id @default(cuid())
  projectId  String
  agentType  String // brainstorm | planning | coding | review
  input      String
  output     String?
  status     String    @default("running") // running | done | error
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

model Event {
  id        String   @id @default(cuid())
  projectId String
  type      String
  payload   String // JSON-encoded string
  createdAt DateTime @default(now())
}
