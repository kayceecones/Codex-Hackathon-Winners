{
  "name": "codex-hackathon-winners-master-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Person 1 Master Agent backend orchestration API for the Codex Hackathon Winners project.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:master": "tsx watch src/server.ts",
    "dev:person5": "npm --prefix coding-review-agent run dev",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "build:all": "npm run build && npm run typecheck:person5",
    "test": "vitest run",
    "test:person1": "vitest run",
    "test:person3": "npm --prefix ResearchAndCoding test",
    "test:all": "npm run test:person1 && npm run test:person3 && npm run typecheck:person5",
    "typecheck:person5": "npm --prefix coding-review-agent run typecheck",
    "demo": "npm run demo:integrated",
    "demo:person1": "tsx src/demo/seed.ts",
    "demo:person3": "npm --prefix ResearchAndCoding run demo:person3",
    "demo:integrated": "tsx scripts/integrated-demo.ts",
    "install:all": "npm install && npm --prefix ResearchAndCoding install && npm --prefix coding-review-agent install",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@notionhq/client": "^2.2.15",
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^5.20.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}